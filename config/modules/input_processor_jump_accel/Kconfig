config INPUT_PROCESSOR_JUMP_ACCEL
    bool "Whole-vector jump-curve pointer acceleration input processor"
    default y
    depends on ZMK_POINTING
    help
      Enables a ZMK input processor implementing a RawAccel-style two-zone
      whole-vector acceleration curve for relative pointer input: a flat
      low-speed factor, a configurable smooth transition, and a flat high-speed
      factor. Optional independent speed and accumulated-distance gates prevent
      brief fast movements from receiving high gain. Synchronized vector path
      history preserves diagonal and reversing movement, with fractional
      remainder tracking to avoid quantizing scaled deltas.

DT_COMPAT_ZMK_BEHAVIOR_TRACKBALL_TUNE := zmk,behavior-trackball-tune

config ZMK_BEHAVIOR_TRACKBALL_TUNE
	bool
	default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_TRACKBALL_TUNE))
	depends on INPUT_PROCESSOR_JUMP_ACCEL
