#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>

#include "charybdis.dtsi"

&default_transform {
    col-offset = <6>;
}; 

&kscan0 {
	col-gpios
		= <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		;
};

// trackball bus
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 17)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        // badjeff driver: CPI + axis mapping live in devicetree, and there are
        // NO snipe-layers/scroll-layers anymore. Pointer speed modes are key
        // behaviors on the trackball_listener below (see charybdis.keymap);
        // scroll mode is the layer-11-scoped scroller child on the listener.
        // cpi 400 + swap-xy/invert-x/invert-y reproduces the old
        // ORIENTATION_90 + INVERT_X mapping exactly (x=-raw_y, y=-raw_x).
        cpi = <400>;
        swap-xy;
        invert-x;
        invert-y;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        // Keep the sensor awake at 4ms sampling (250Hz) while ZMK is ACTIVE,
        // downshift to power saving when idle (replaces POLLING_RATE_250).
        force-awake;
        force-awake-4ms-mode;
    };
};


//RGB bus
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        /* SPI */
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* WS2812 */
        chain-length = <27>; /* number of LEDs */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};



/ {
    // jump_accel is defined in charybdis.keymap (shared file) but wired onto
    // this listener here, in the right-only overlay, since trackball_listener
    // doesn't exist on the left shield's build.
    //
    // Chain order: jump_accel sees raw sensor counts first (its cps thresholds
    // stay calibrated), then the pipeline switch (cursor/snipe/fast, driven by
    // the &bmode-based mode keys in charybdis.keymap).
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        input-processors = <&jump_accel &zip_ball_mode>;

        // L11 is a dedicated all-transparent scroll mode layer — holding any
        // @scroll:LX:hold key activates L11 (transparent, so LX bindings show
        // through) and this layer-scoped child turns ball motion into scroll.
        // Scroll scaler is <multiplier divisor>: 1/2 = half-speed scroll.
        // track-remainders carries sub-tick fractions, so no dead zone.
        scroller {
            layers = <11>;
            input-processors = <&zip_xy_to_scroll_mapper &zip_scroll_scaler 1 2>;
        };
    };
};


