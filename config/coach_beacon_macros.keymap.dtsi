            tap-ms = <40>;
            bindings =
                <&macro_press &coach_beacon 10 0>,
                <&macro_press &mo 10>,
                <&macro_pause_for_release>,
                <&macro_release &mo 10>,
                <&macro_release &coach_beacon 10 0>;
        };

        // coach_l<N>_scroll_hold: holding these activates L11 (scroll mode - see
        // scroll-layers in charybdis_right.overlay) AND layer N simultaneously, so
        // the held key's bindings show layer N's shortcuts instead of falling
        // through to whatever layer was already active. Plain "&mo 11" alone (used
        // for scroll-hold keys before this) only ever exposes the layer already
        // active underneath it - it cannot reveal a different target layer's
        // bindings. Reuses the private GATT beacon used by coach_lN_hold below,
        // so the AHK helper reports "layer N held" the
        // same way regardless of whether it was a plain hold or a scroll-hold - the
        // coach only cares that layer N is active, not which key caused it.
        coach_l1_scroll_hold: coach_l1_scroll_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press &coach_beacon 1 0>,
                <&macro_press &mo 11 &mo 1>,
                <&macro_pause_for_release>,
                <&macro_release &mo 11 &mo 1>,
                <&macro_release &coach_beacon 1 0>;
        };

        coach_l2_scroll_hold: coach_l2_scroll_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press &coach_beacon 2 0>,
                <&macro_press &mo 11 &mo 2>,
                <&macro_pause_for_release>,
                <&macro_release &mo 11 &mo 2>,
