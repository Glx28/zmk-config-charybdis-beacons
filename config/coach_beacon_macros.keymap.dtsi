/* Coach state is sent over the private GATT service, never as keyboard input. */

coach_beacon: coach_beacon {
    compatible = "zmk,behavior-coach-beacon";
    #binding-cells = <2>;
    display-name = "Coach Beacon";
};

coach_l1_hold: coach_l1_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press &coach_beacon 1 0>,
                <&macro_press &mo 1>,
                <&macro_pause_for_release>,
                <&macro_release &mo 1>,
                <&macro_release &coach_beacon 1 0>;
        };

        coach_l2_hold: coach_l2_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press &coach_beacon 2 0>,
                <&macro_press &mo 2>,
                <&macro_pause_for_release>,
                <&macro_release &mo 2>,
                <&macro_release &coach_beacon 2 0>;
        };

        coach_l3_hold: coach_l3_hold {
            compatible = "zmk,behavior-macro";
