#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    // Whole-vector jump-curve acceleration (config/modules/input_processor_jump_accel).
    // Wired onto &trackball_listener below -- the REAL PMW3610 hardware listener --
    // not &mmv_input_listener (that's the virtual "hold a key to move the mouse"
    // behavior's listener, and &mmv isn't bound to any key in this keymap, so
    // anything attached there is inert dead code for actual trackball movement).
    // Runs on raw 400-CPI sensor deltas, so speed thresholds are in raw counts/sec.
    // base-factor 1000 = 1.0x (slow feel unchanged, stays at the raw 400 CPI baseline).
    // fast-factor 3000 = 3.0x, so a fast flick reaches ~1200 raw-equivalent CPI.
    // First real tuning pass on the correct listener -- expect a noticeable jump on
    // brisk movement; adjust jump-start-cps/jump-width-cps by feel from here.
    jump_accel: jump_accel {
        compatible = "zmk,input-processor-jump-accel";
        #input-processor-cells = <0>;
        base-factor = <1000>;
        fast-factor = <3000>;
        jump-start-cps = <1800>;
        jump-width-cps = <1200>;
        track-remainders;
    };
};

// Pointer speed modes are KEY behaviors, never layer-linked CPI switching.
// The old PMW3610 snipe-layers mechanism (8x CPI jump while a layer was held)
// was removed together with the inorichi/DoctorWangWang driver.
//
// All modes run through zip_ball_mode (gggw zmk-input-processor-pipeline-
// switch), wired onto &trackball_listener in charybdis_right.overlay (which
// exists on the right/central half only, so these keys only have an effect
// when placed on right-half positions). The macros below select a pipeline
// deterministically; the hold variants press a mode and restore cursor on
// release (same macro pattern as the coach layer holds). persist=0 for the
// hold transitions (no flash writes), persist=1 for the explicit set keys.
// Behavior node names must stay <= 8 chars (split relay truncation).
//
// These behaviors are intentionally NOT bound to any key in this keymap.
// They exist so ZMK Studio can assign them; the optimizer owns placement.

/ {
    zip_ball_mode: zip_ball_mode {
        compatible = "zmk,input-processor-pipeline-switch";
        #input-processor-cells = <0>;
        persistent;

        cursor { // index 0: identity
            input-processors = <&zip_xy_scaler 1 1>;
        };
        snipe { // index 1: 0.25x precision
            input-processors = <&zip_xy_scaler 1 4>;
        };
        fast { // index 2: 3x boost
            input-processors = <&zip_xy_scaler 3 1>;
        };
    };

    bmode: bmode {
        compatible = "zmk,behavior-pipeline-switch";
        #binding-cells = <2>;
        processor = <&zip_ball_mode>;
        display-name = "Ball Mode";
    };

    snp_hold: snp_hold {
        compatible = "zmk,behavior-macro";
        display-name = "Snipe Hold";
        #binding-cells = <0>;
        wait-ms = <5>;
        tap-ms = <5>;
        bindings =
            <&macro_press &bmode 1 0>,
            <&macro_pause_for_release>,
            <&macro_tap &bmode 0 0>;
    };

    fst_hold: fst_hold {
        compatible = "zmk,behavior-macro";
        display-name = "Fast Hold";
        #binding-cells = <0>;
        wait-ms = <5>;
        tap-ms = <5>;
        bindings =
            <&macro_press &bmode 2 0>,
            <&macro_pause_for_release>,
            <&macro_tap &bmode 0 0>;
    };

    snp_tog: snp_tog {
        compatible = "zmk,behavior-macro";
        display-name = "Snipe Mode";
        #binding-cells = <0>;
        wait-ms = <5>;
        tap-ms = <5>;
        bindings = <&macro_tap &bmode 1 1>;
    };

    nrm_tog: nrm_tog {
        compatible = "zmk,behavior-macro";
        display-name = "Normal Mode";
        #binding-cells = <0>;
        wait-ms = <5>;
        tap-ms = <5>;
        bindings = <&macro_tap &bmode 0 1>;
    };

    fst_tog: fst_tog {
        compatible = "zmk,behavior-macro";
        display-name = "Fast Mode";
        #binding-cells = <0>;
        wait-ms = <5>;
        tap-ms = <5>;
        bindings = <&macro_tap &bmode 2 1>;
    };
};

// zip_xy_scaler here only affects the (currently unused) &mmv "move mouse via
// key hold" virtual behavior below -- unrelated to the physical trackball.
&mmv_input_listener { input-processors = <&zip_xy_scaler 1 5>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    #include "coach_beacon_macros.keymap.dtsi"

    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    behaviors {
    };

    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To1_macro_A: To1_macro_A {
            compatible = "zmk,behavior-macro";
            label = "To1_macro_A";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro_A: To2_macro_A {
            compatible = "zmk,behavior-macro";
            label = "To2_macro_A";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(250,100,50) &to 2>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(250,100,50) &to 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3        &kp N4     &kp N5      &kp N6     &kp N7     &kp N8     &kp N9            &kp N0    &kp BACKSPACE
&kp TAB         &kp Q   &kp W   &kp E         &kp R      &kp T       &kp Y      &kp U      &kp I      &kp O             &kp P     &kp BSLH
&kp LEFT_SHIFT  &kp A   &kp S   &kp D         &kp F      &kp G       &kp H      &kp J      &kp K      &kp L             &kp SEMI  &kp SQT
&kp LCTRL       &kp Z   &kp X   &kp C         &kp V      &kp B       &kp N      &kp M      &kp COMMA  &kp LEFT_BRACKET  &kp FSLH  &kp MINUS
                                &kp LEFT_ALT  &kp SPACE  &to 1       &kp LWIN   &kp SPACE
                                              &mkp MB1   &mkp MB2    &kp ENTER
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };

        layer_1 {
            bindings = <
&kp F1          &kp F2           &kp F3           &kp F4           &kp F5           &kp F6        &kp F7     &kp F8    &kp F9      &kp F10            &kp F11  &kp F12
&kp CAPS        &none            &none            &none            &none            &none         &none      &none     &kp UP      &none              &none    &none
&kp LEFT_SHIFT  &none            &none            &none            &bt BT_NXT       &bt BT_CLR    &none      &kp LEFT  &kp DOWN    &kp RIGHT          &none    &none
&kp LCTRL       &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_EFF  &rgb_ug RGB_TOG  &none         &none      &none     &kp PERIOD  &kp RIGHT_BRACKET  &none    &kp EQUAL
                                                  &kp LEFT_ALT     &kp SPACE        &to 0         &none      &none
                                                                   &mkp MB1         &mkp MB2      &kp ENTER
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &none     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &none     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        layer_10 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        // L11: dedicated scroll mode layer — all transparent.
        // A layer-11-scoped child of trackball_listener in charybdis_right.overlay
        // converts ball motion to scroll whenever this layer is active. Every
        // @scroll:LX:hold key exports as &mo 11, which stacks L11 on top of the
        // current layer without displacing it (L11 is fully transparent so LX
        // bindings remain visible).
        layer_11 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

    };
};
