     }
 }
 
-static int pmw3610_report_data(const struct device *dev) {
+static void pmw3610_report_retry_callback(struct k_work *work);
+
+static void pmw3610_schedule_report_retry(struct pixart_data *data, k_timeout_t delay) {
+    k_work_schedule(&data->report_retry_work, delay);
+}
+
+static int pmw3610_report_pending(const struct device *dev) {
     struct pixart_data *data = dev->data;
     const struct pixart_config *config = dev->config;
+    int16_t rx = (int16_t)CLAMP(data->pending_dx, INT16_MIN, INT16_MAX);
+    int16_t ry = (int16_t)CLAMP(data->pending_dy, INT16_MIN, INT16_MAX);
+    bool have_x = rx != 0;
+    bool have_y = ry != 0;
+    if (!have_x && !have_y) {
+        return 0;
+    }
+#if CONFIG_PMW3610_REPORT_INTERVAL_MIN > 0
+    int64_t now = k_uptime_get();
+    int64_t elapsed = now - data->last_report_time_ms;
+    if (elapsed < CONFIG_PMW3610_REPORT_INTERVAL_MIN) {
+        pmw3610_schedule_report_retry(
+            data, K_MSEC(CONFIG_PMW3610_REPORT_INTERVAL_MIN - elapsed));
+        return 0;
+    }
+#endif
+
+    int report_err = 0;
+    bool reported = false;
+
+    if (have_x) {
+        report_err = input_report(dev, config->evt_type, config->x_input_code, rx, !have_y,
+                                  K_NO_WAIT);
+        if (!report_err) {
+            data->pending_dx -= rx;
+            reported = true;
+        }
+    }
+    if (have_y) {
+        int y_err = input_report(dev, config->evt_type, config->y_input_code, ry, true, K_NO_WAIT);
+        if (!y_err) {
+            data->pending_dy -= ry;
+            reported = true;
+        } else if (!report_err) {
+            report_err = y_err;
+        }
+    }
+
+#if CONFIG_PMW3610_REPORT_INTERVAL_MIN > 0
+    if (reported) {
+        data->last_report_time_ms = k_uptime_get();
+    }
+#endif
+
+    if (report_err || data->pending_dx != 0 || data->pending_dy != 0) {
+        /* Never block the sensor work item: its caller must re-enable the PMW3610 IRQ. */
+        pmw3610_schedule_report_retry(data, K_MSEC(1));
+        if (report_err) {
+            LOG_DBG("Input queue busy; retaining movement for retry (%d)", report_err);
+        }
+    }
+
+    return report_err;
+}
+
+static void pmw3610_report_retry_callback(struct k_work *work) {
+    struct k_work_delayable *delayable = CONTAINER_OF(work, struct k_work_delayable, work);
+    struct pixart_data *data = CONTAINER_OF(delayable, struct pixart_data, report_retry_work);
+    pmw3610_report_pending(data->dev);
+}
+
+static int pmw3610_report_data(const struct device *dev) {
+    struct pixart_data *data = dev->data;
     uint8_t buf[PMW3610_BURST_SIZE];
 
     if (unlikely(!data->ready)) {
@@ -432,16 +501,7 @@
         return -EBUSY;
     }
 
-    static int64_t dx = 0;
